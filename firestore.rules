rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'helloteezowk@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role', 'createdAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        data.role in ['patient', 'admin'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Consultation validation
    function isValidConsultation(data) {
      return data.keys().hasAll(['id', 'userId', 'patientName', 'phone', 'email', 'treatments', 'preferredDate', 'preferredTime', 'status', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 100 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 150 &&
        data.treatments is list && data.treatments.size() > 0 && data.treatments.size() <= 20 &&
        data.preferredDate is string && data.preferredDate.size() <= 20 &&
        data.preferredTime is string && data.preferredTime.size() <= 20 &&
        data.status in ['new', 'contacted', 'scheduled', 'completed', 'cancelled'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Review validation to prevent spam
    function isValidReview(data) {
      return data.keys().hasAll(['id', 'userId', 'authorName', 'treatment', 'rating', 'comment', 'status', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60 &&
        data.treatment is string && data.treatment.size() > 0 && data.treatment.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 10 && data.comment.size() <= 500 &&
        data.status in ['published', 'pending', 'flagged'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Consultations collection (Patients view their own; Admins view all)
    match /consultations/{consultationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidConsultation(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidConsultation(incoming());
      allow delete: if isAdmin();
    }

    // Reviews collection (Public reading for published; Verified users can submit; Admins moderate)
    match /reviews/{reviewId} {
      allow get: if resource.data.status == 'published' || (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow list: if resource.data.status == 'published' || (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReview(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidReview(incoming());
      allow delete: if isAdmin();
    }

    // Admins collection (read-only for members check)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
