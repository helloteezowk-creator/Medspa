# ====================================================================
# Lumina Medical Spa — Environment Variables Template
# Copy this file to '.env' and populate with your own project secrets.
# DO NOT COMMIT REAL CREDENTIALS, SERVICE ROLE KEYS, OR PASSWORDS HERE.
# ====================================================================

# Gemini AI Studio Configuration (Injected automatically in AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
APP_URL="https://your-production-domain.com"

# Supabase Client Configuration
# WARNING:
# 1. Only expose the anon/publishable key client-side.
# 2. NEVER put the 'service_role' secret key here or anywhere in client code.
# 3. Ensure Row Level Security (RLS) is enabled on every table (see /supabase/schema.sql).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
